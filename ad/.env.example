# ad_server.py requires P6_AUTH_MODE=windows. No dotenv loader.
P6_AUTH_MODE=windows
P4_PBIRS_URL=https://pbirs.example.internal
P6_PUBLIC_URL=https://p6.example.internal:8765
P6_BACKEND_PORT=8766
P6_AD_HOST=dc.example.internal
P6_AD_PORT=636
P6_AD_BASE_DN=OU=ReportUsers,DC=example,DC=internal
P6_AD_NETBIOS=EXAMPLE
P6_AD_BIND_USER=reader@example.internal
# Set P6_AD_BIND_PASSWORD from a protected service environment. Never commit it.
P6_AD_CA_FILE=C:\ProgramData\P6Demo\ad-ca.pem
P6_AD_ADMINS=EXAMPLE\reportadmin
P6_AD_SYNC_SECONDS=300
# Generate 32 random bytes in base64; shared only by gateway and Python backend.
# P6_GATEWAY_KEY=
P6_RULES_PATH=C:\ProgramData\P6Demo\rls-rules.local.json
P6_RULES_MAX_AGE=600
