P6_AUTH_MODE=windows
P6_DIRECTORY_SOURCE=local
P4_PBIRS_URL=http://pbirs.example.internal
P6_PUBLIC_URL=http://pbirs.example.internal:8765
P6_BACKEND_PORT=8766
P6_WINDOWS_ADMINS=SERVERNAME\Administrator
P6_AD_SYNC_SECONDS=300
# Random base64 secret shared only between native gateway and backend.
# P6_GATEWAY_KEY=
P6_RULES_PATH=C:\ProgramData\P6WindowsDemo\rls-rules.local.json
